# Copy to secrets.toml for local testing (gitignored, never committed).
# On Streamlit Cloud: App settings -> Secrets -> paste the same key/value.
app_password = "choose-a-real-passphrase-here"

# Optional — enables the "Sync now" button, which asks GitHub Actions to run
# .github/workflows/daily-sync.yml. Without it the report still shows when the
# data was last synced and whether the nightly run succeeded; only the button
# is disabled.
#
# Use a FINE-GRAINED personal access token, scoped to this repository only,
# with the single permission "Actions: read and write". A classic token with
# blanket `repo` scope grants far more than this needs.
# github_token = "github_pat_..."
#
# Only needed if the repository is not Mornayvh/specialized-sales-report.
# github_repo = "owner/name"
